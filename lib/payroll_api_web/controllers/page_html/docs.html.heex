<div class="min-h-screen bg-slate-50 py-10 px-4">
  <div class="max-w-4xl mx-auto">
    <div class="text-center mb-8">
      <p class="text-sm font-semibold text-emerald-600 uppercase tracking-wide">
        Malaysia Statutory Payroll API
      </p>
      <h1 class="text-3xl font-bold text-slate-900 mt-1">API Documentation</h1>
      <p class="text-slate-500 mt-2">Authenticated API — use a Bearer API key</p>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <div class="px-6 py-4 bg-slate-900">
        <code class="text-sm text-slate-100">GET /api/v1/rates</code>
      </div>
      <div class="p-6 text-sm">
        <p class="text-slate-600 mb-3">
          Fetch current statutory rates (EPF, SOCSO, EIS, HRDF, minimum wage) for a given year.
        </p>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-slate-500 border-b border-slate-200">
              <th class="py-2">Param</th><th class="py-2">Type</th><th class="py-2">Default</th><th class="py-2">
                Description
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-slate-100">
              <td class="py-2 font-mono">year</td><td class="py-2">int</td><td class="py-2">
                2026
              </td><td class="py-2 text-slate-600">Rate year</td>
            </tr>
          </tbody>
        </table>
        <div class="mt-4 bg-slate-50 rounded-lg p-4">
          <p class="text-xs text-slate-500 mb-1">Example</p>
          <code class="text-xs text-slate-800">curl -H "Authorization: Bearer $PAYROLL_API_KEY" https://payroll-api.example.com/api/v1/rates?year=2026</code>
        </div>
      </div>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden mb-6">
      <div class="px-6 py-4 bg-slate-900">
        <code class="text-sm text-slate-100">POST /api/v1/calculate-payslip</code>
      </div>
      <div class="p-6 text-sm">
        <p class="text-slate-600 mb-3">
          Compute full statutory breakdown (EPF + SOCSO + EIS + HRDF) for a gross monthly wage.
        </p>
        <table class="w-full text-sm">
          <thead>
            <tr class="text-left text-slate-500 border-b border-slate-200">
              <th class="py-2">Field</th><th class="py-2">Type</th><th class="py-2">Required</th><th class="py-2">
                Description
              </th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-slate-100">
              <td class="py-2 font-mono">wage</td><td class="py-2">number</td><td class="py-2 text-emerald-600 font-medium">
                yes
              </td><td class="py-2 text-slate-600">Gross monthly wage (RM)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-2 font-mono">include_hrdf</td><td class="py-2">bool</td><td class="py-2">
                no
              </td><td class="py-2 text-slate-600">Include HRDF levy (default true)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-2 font-mono">married</td><td class="py-2">bool</td><td class="py-2">
                no
              </td><td class="py-2 text-slate-600">Spouse tax relief (default false)</td>
            </tr>
            <tr class="border-b border-slate-100">
              <td class="py-2 font-mono">children</td><td class="py-2">int</td><td class="py-2">
                no
              </td><td class="py-2 text-slate-600">Children under 18 (default 0)</td>
            </tr>
            <tr>
              <td class="py-2 font-mono">year</td><td class="py-2">int</td><td class="py-2">
                no
              </td><td class="py-2 text-slate-600">Rate year (default 2026)</td>
            </tr>
          </tbody>
        </table>
        <div class="mt-4 bg-slate-50 rounded-lg p-4">
          <p class="text-xs text-slate-500 mb-1">Example</p>
          <pre class="text-xs text-slate-800 whitespace-pre-wrap"><%= "curl -X POST https://payroll-api.example.com/api/v1/calculate-payslip \\" %><%= "\n  -H \"Authorization: Bearer $PAYROLL_API_KEY\" \\" %><%= "\n  -H \"Content-Type: application/json\" \\" %><%= "\n  -d '{\"wage\": 5000}'" %></pre>
        </div>
      </div>
    </div>

    <div class="text-center">
      <a href="/" class="text-emerald-600 hover:text-emerald-700 text-sm font-medium">← Back to calculator</a>
    </div>
  </div>
</div>
